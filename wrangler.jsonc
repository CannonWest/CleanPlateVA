// Cloudflare Workers deployment config.
//
// The worker (src/worker.js) serves two tiers:
//   - static assets from public/ (the site + the committed lite data)
//   - /data-full/* from the R2 bucket (the full inspection archive,
//     Cloudflare Access-gated at the edge; see src/worker.js)
//
// Deployed by the Workers Builds git integration running
// `npx wrangler deploy` on push. workers.dev publishing is off (no
// subdomain registered); the worker deploys straight to its custom
// domains. preview_urls off for the same reason.
{
    "name": "cleanplateva",
    "compatibility_date": "2026-07-03",
    "main": "src/worker.js",
    "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "run_worker_first": ["/data/manifest.json", "/data/finder/*"],
        // Real per-view URLs (/list, /about — static/js/router.js): any path
        // that is not an asset gets index.html and the client routes it
        // (unknown paths normalize to /). Assets and the /data/* + /data-full/*
        // routing above are unaffected.
        "not_found_handling": "single-page-application"
    },
    "r2_buckets": [
        {
            "binding": "DATA_FULL",
            "bucket_name": "cleanplateva-data"
        }
    ],
    "workers_dev": false,
    "preview_urls": false,
    "routes": [
        { "pattern": "cleanplateva.com", "custom_domain": true },
        { "pattern": "www.cleanplateva.com", "custom_domain": true }
    ]
}
