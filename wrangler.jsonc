// Cloudflare Workers deployment config.
//
// The worker (src/worker.js) serves two tiers:
//   - static assets from public/ (the site + the committed lite data)
//   - /data-full/* from the R2 bucket (the full inspection archive — a
//     PUBLIC channel since CPF-M2: public cache-control + Cache API at the
//     edge; the tier boundary is the client's acknowledgement, see
//     public/static/js/ack.js and design ref §9)
//
// Deployed by the Workers Builds git integration running
// `npx wrangler deploy` on push. workers.dev publishing is off (no
// subdomain registered); the worker deploys straight to its custom
// domains. preview_urls off for the same reason.
{
    "name": "cleanplateva",
    "compatibility_date": "2026-07-03",
    "main": "src/worker.js",
    "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        // In its array form this list is THE set of paths that invoke the
        // worker at all (docs: "define the routes that invoke your Worker
        // explicitly"; it also opts out of the Sec-Fetch-Mode heuristic).
        // Everything else is answered by the assets layer — including the
        // SPA fallback below. Both channels the worker owns must therefore
        // be listed:
        //   /data/*       public channel — cache-control on the manifest and
        //                 the content-addressed shards, and the re-404 of a
        //                 missing shard the SPA fallback would otherwise
        //                 answer with 200 + the HTML shell (dataClient would
        //                 parse markup as JSON).
        //   /data-full/*  the R2-backed full channel — not a static asset,
        //                 so under the SPA fallback it is index.html unless
        //                 the worker runs first. Before the fallback existed
        //                 a miss fell through to the worker on its own; the
        //                 fallback removed that path (measured 2026-08-16:
        //                 the un-Access-gated www host answered
        //                 /data-full/manifest.json with the shell, and the
        //                 authenticated tier degraded to gray Lite).
        // Static assets deliberately stay on the fast path (no worker
        // invocation per file): a missing .js there surfaces immediately as
        // a console MIME error rather than a silent mis-parse.
        "run_worker_first": ["/data/*", "/data-full/*"],
        // Real per-view URLs (/list, /about — static/js/router.js): any path
        // that is not an asset gets index.html and the client routes it
        // (unknown paths normalize to /). Assets and the /data/* + /data-full/*
        // routing above are unaffected.
        "not_found_handling": "single-page-application"
    },
    "r2_buckets": [
        {
            "binding": "DATA_FULL",
            "bucket_name": "cleanplateva-data"
        }
    ],
    "workers_dev": false,
    "preview_urls": false,
    "routes": [
        { "pattern": "cleanplateva.com", "custom_domain": true },
        { "pattern": "www.cleanplateva.com", "custom_domain": true }
    ]
}
