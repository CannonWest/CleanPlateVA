__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/

# Local secrets. `.dev.vars` is the Workers convention and `.env*` the
# Vite one; neither exists today, and both are ignored so that neither
# can be committed by accident on the day one does.
.env
.env.*
.dev.vars
.dev.vars.*

# Data tiers. The LITE finder shards + freshness/integrity manifest are
# committed and deploy with the site. The FULL
# inspection archive is never committed — it's served from R2 behind the
# terms acknowledgement; data-full/ exists locally only for dev.
public/data/*
!public/data/manifest.json
!public/data/finder/
!public/data/finder/*.json
public/data-full/

# wrangler local state
.wrangler/

# CR scaffold (CRF-M0): npm install product + Vite build output. dist/ is
# built by Workers Builds on deploy (design ref §3); it is never committed.
node_modules/
dist/

# The e2e smoke (tests/e2e/, Playwright): traces, screenshots, the HTML report.
test-results/
playwright-report/
