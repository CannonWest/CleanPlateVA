__pycache__/
*.pyc
.env
.venv/
venv/
*.egg-info/

# Data tiers. The LITE payload (facilities.json — the 12-field identity,
# location, and source-routing finder contract) is committed and deploys with
# the site. The FULL
# inspection archive is never committed — it's served from a private,
# authenticated channel; data-full/ exists locally only for dev.
public/data/*
!public/data/facilities.json
public/data-full/

# wrangler local state
.wrangler/
