// The DUAL-TRACK preview worker (stood up 2026-08-30, pre-CRC): serves the
// BUILT React client (./dist) at next.cleanplateva.com while production
// (wrangler.jsonc — ./public, the no-build client) keeps serving
// cleanplateva.com untouched. Same worker code, same R2 bucket (the worker
// is GET/HEAD read-only), same run_worker_first surface — this is CRC-M0's
// dry run on a real Workers host: anything the flip would break shows here
// first, with a one-command rollback of nothing (production never moved).
//
// Deployed MANUALLY from the checkout, never by Workers Builds:
//   npx vite build && npx wrangler deploy -c wrangler.preview.jsonc
//
// The dist/ snapshot of public/data/** goes stale as cannon-food publishes;
// rebuild + redeploy to refresh. Retires (worker deleted, this file removed)
// when CRC's one-PR flip lands and production serves ./dist itself.
{
    "name": "cleanplateva-preview",
    "compatibility_date": "2026-07-03",
    "main": "src/worker.js",
    "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "run_worker_first": ["/data-full/*"],
        "not_found_handling": "single-page-application"
    },
    "r2_buckets": [
        {
            "binding": "DATA_FULL",
            "bucket_name": "cleanplateva-data"
        }
    ],
    "workers_dev": false,
    "preview_urls": false,
    "routes": [
        { "pattern": "next.cleanplateva.com", "custom_domain": true }
    ]
}
